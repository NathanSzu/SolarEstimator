# Copy to .env.local and fill in. All keys are optional.
# NOTE: VITE_* values are bundled into public JS. Use free/restricted keys only.

# OpenWeatherMap geocoding (falls back to keyless Open-Meteo if unset)
VITE_OPENWEATHER_API_KEY=

# EIA residential electricity rate lookup (button hidden if unset)
VITE_EIA_API_KEY=
